<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● AICARIES"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/teal_main"
        android:layout_marginBottom="60dp"/>

    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="40dp">
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_circle_light_teal"/>
        <ImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:src="@drawable/tooth_logo"
            android:layout_gravity="center"
            android:scaleType="fitCenter"/>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="260dp"
        android:layout_height="6dp"
        android:indeterminate="false"
        android:progress="30"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:progressTint="@color/teal_main"
        android:progressBackgroundTint="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvLoadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading your dental profile..."
        android:textSize="14sp"
        android:textColor="@color/text_medium"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginEnd="6dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_active"
            android:layout_marginEnd="6dp"/>
        <View android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/dot_active"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOADING YOUR SMILE EXPERIENCE..."
        android:textSize="11sp"
        android:textColor="@color/text_light"/>

</LinearLayout>